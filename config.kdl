// Lniri Configuration Example with Liquid & KWin Glass effects
// Copy or symlink to ~/.config/lniri/config.kdl (or ~/.config/niri/config.kdl)

// ============================================================================
// WINDOW RULES
// ============================================================================

// Window Rule with KWin Glass Effect (Default: Authentic KWin Glass)
window-rule {
    match app-id=".*"
    background-effect {
        blur true
        xray true
        liquid-glass {
            // Engine mode: "kwin-glass" (authentic kwin-effects-glass) or "liquid" (water-drop fluid)
            mode "kwin-glass"

            // Refraction & Bevel Optics
            refraction-strength 4.0          // Optical refraction strength (IOR = 1.0 + strength)
            power-factor 3.0                 // Curvature steepness (RefractionNormalPow)
            refraction-bevel-intensity 10.0  // Caustic bevel depth & lens magnitude
            refraction-offset-strength 8.0   // Corner optical shift factor
            edge-thickness 0.18              // Meniscus / bevel border width
            fringing 0.45                    // Cauchy chromatic dispersion (RGB fringing)

            // Outline & Lighting
            glow-weight 0.20                 // Dual-highlight / shadow rim profile intensity
            edge-lighting 0.6                // Natural wallpaper edge illumination

            // Perceptual Color Pipeline
            oklab-saturation 1.0             // 1.0 = enable Oklab color-space saturation
            saturation 1.15                  // Perceptual color saturation
            brightness 1.0                   // Brightness adjustment
            contrast 1.0                     // Contrast adjustment
        }
    }
}

// Layer Shell Rules (bars, docks, launchers, e.g. mistbar, waybar, fuzzel)
layer-rule {
    match namespace="^mistbar.*"
    match namespace="^waybar.*"
    match namespace="^bar.*"
    geometry-corner-radius 12
    background-effect {
        blur true
        xray true // Set xray false if you want the bar to refract windows underneath
        liquid-glass {
            mode "kwin-glass"
            refraction-strength 4.5
            power-factor 3.2
            refraction-bevel-intensity 12.0
            refraction-offset-strength 8.0
            edge-thickness 0.20
            fringing 0.45
            edge-lighting 0.8
            glow-weight 0.25
            oklab-saturation 1.0
            saturation 1.2
        }
    }
}

// ============================================================================
// ALTERNATIVE CURATED PRESETS (Copy any block into your window-rule above)
// ============================================================================

